# ============================================================
# OmniaPilot — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- n8n -------------------------------------------------------
# URL publique de votre instance n8n (sans slash final)
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com

# Optionnel : clé API n8n pour appels inter-workflows
N8N_API_KEY=

# --- Supabase --------------------------------------------------
# URL de votre projet Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé service_role (JAMAIS la anon key — accès complet RLS bypass)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Email (SMTP) pour l'envoi des emails Tier 3 ---------------
EMAIL_FROM=karim@purity-agency.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=karim@purity-agency.com
SMTP_PASS=your-smtp-password-or-app-password

# Email d'Amir (destinataire des escalades Tier 3)
AMIR_EMAIL=amir@purity-agency.com

# --- IMAP (lecture des réponses email d'Amir) ------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=amir@purity-agency.com
IMAP_PASS=your-imap-password-or-app-password

# --- Agents (Webhooks n8n de chaque agent) ----------------------
# Ces URLs sont automatiquement construites depuis N8N_WEBHOOK_BASE_URL
# Format : {N8N_WEBHOOK_BASE_URL}/webhook/agent-{nom}
# Exemple : https://your-n8n-instance.com/webhook/agent-alex

# Agents Tier 1
AGENT_ALEX_WEBHOOK=/webhook/agent-alex
AGENT_JULIE_WEBHOOK=/webhook/agent-julie
AGENT_SARAH_WEBHOOK=/webhook/agent-sarah
AGENT_SALMA_WEBHOOK=/webhook/agent-salma
AGENT_NABIL_WEBHOOK=/webhook/agent-nabil
AGENT_LINA_WEBHOOK=/webhook/agent-lina
AGENT_YANIS_WEBHOOK=/webhook/agent-yanis
AGENT_VICTOR_WEBHOOK=/webhook/agent-victor
AGENT_OMAR_WEBHOOK=/webhook/agent-omar

# Agent Tier 2
AGENT_AMIR_NOTIFY_WEBHOOK=/webhook/agent-amir-notify
