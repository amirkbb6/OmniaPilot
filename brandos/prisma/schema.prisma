generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum AssetKind {
  IMAGE
  VIDEO
  FONT
  DOC
}

enum EntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  PLANNED
  RUNNING
  DONE
}

enum SyncDirection {
  OUT
  IN
}

enum SyncKind {
  PRODUCT
  VARIANT
  IMAGE
  ORDER
  INVENTORY
}

enum SyncStatus {
  PENDING
  RETRY
  DONE
  ERROR
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  members   Member[]
  auditLogs AuditLog[]
}

model Org {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now())
  members   Member[]
  brandKit  BrandKit?
  assets    Asset[]
  collections Collection[]
  entries   Entry[]
  pages     Page[]
  campaigns Campaign[]
  featureFlags FeatureFlag[]
  auditLogs AuditLog[]
  shopifyShop ShopifyShop?
  productMaps ShopifyProductMap[]
  variantMaps ShopifyVariantMap[]
  orderMaps ShopifyOrderMap[]
  syncJobs  SyncJob[]
}

model Member {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  org    Org    @relation(fields: [orgId], references: [id])
  orgId  String
  role   Role

  @@unique([userId, orgId])
}

model BrandKit {
  id        String @id @default(cuid())
  org       Org    @relation(fields: [orgId], references: [id])
  orgId     String @unique
  logoUrl   String?
  palette   Json
  typography Json
  tokens    Json
  tone      String?
}

model Asset {
  id        String    @id @default(cuid())
  org       Org       @relation(fields: [orgId], references: [id])
  orgId     String
  kind      AssetKind
  title     String
  url       String
  meta      Json
  createdAt DateTime  @default(now())

  @@index([orgId, kind])
}

model Collection {
  id     String @id @default(cuid())
  org    Org    @relation(fields: [orgId], references: [id])
  orgId  String
  name   String
  schema Json

  @@unique([orgId, name])
}

model Entry {
  id           String      @id @default(cuid())
  org          Org         @relation(fields: [orgId], references: [id])
  orgId        String
  collection   Collection  @relation(fields: [collectionId], references: [id])
  collectionId String
  slug         String
  data         Json
  status       EntryStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([orgId, slug, collectionId])
}

model Page {
  id        String      @id @default(cuid())
  org       Org         @relation(fields: [orgId], references: [id])
  orgId     String
  path      String
  blocks    Json
  seo       Json?
  status    EntryStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, path])
}

model Campaign {
  id        String         @id @default(cuid())
  org       Org            @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  brief     String?
  channels  Json
  assets    Json
  schedule  Json?
  kpis      Json?
  status    CampaignStatus @default(PLANNED)
  createdAt DateTime       @default(now())

  @@index([orgId])
}

model FeatureFlag {
  id      String @id @default(cuid())
  org     Org    @relation(fields: [orgId], references: [id])
  orgId   String
  key     String
  enabled Boolean @default(false)

  @@unique([orgId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  target    String
  meta      Json
  createdAt DateTime @default(now())
}

model ShopifyShop {
  id              String @id @default(cuid())
  org             Org    @relation(fields: [orgId], references: [id])
  orgId           String @unique
  shopDomain      String
  accessToken     String
  storefrontToken String?
}

model ShopifyProductMap {
  id               String @id @default(cuid())
  org              Org    @relation(fields: [orgId], references: [id])
  orgId            String
  entry            Entry  @relation(fields: [entryId], references: [id])
  entryId          String
  shopifyProductId String

  @@unique([orgId, entryId])
}

model ShopifyVariantMap {
  id               String @id @default(cuid())
  org              Org    @relation(fields: [orgId], references: [id])
  orgId            String
  entry            Entry  @relation(fields: [entryId], references: [id])
  entryId          String
  variantKey       String
  shopifyVariantId String

  @@unique([orgId, entryId, variantKey])
}

model ShopifyOrderMap {
  id            String @id @default(cuid())
  org           Org    @relation(fields: [orgId], references: [id])
  orgId         String
  shopifyOrderId String
  status        String
  data          Json
}

model SyncJob {
  id        String       @id @default(cuid())
  org       Org          @relation(fields: [orgId], references: [id])
  orgId     String
  direction SyncDirection
  kind      SyncKind
  payload   Json
  status    SyncStatus   @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  createdAt DateTime     @default(now())
}
